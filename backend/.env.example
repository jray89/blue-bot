# Copy to backend/.env and fill in. Never commit the real .env — it is
# gitignored, and .dockerignore keeps it out of the image as well.
#
# In production these are set as Railway environment variables, not from a file.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required in production only. Generate with: bin/rails secret
# SECRET_KEY_BASE=

# Global hard cap on questions per day. ~$0.04/question, so 16/day ≈ $20/month.
# DAILY_QUESTION_LIMIT=16

# Concurrent askers. Each SSE stream holds a Puma thread for its whole life.
# RAILS_MAX_THREADS=12

# Extra origins allowed to call /api/* cross-origin, comma separated.
# Not needed in production, where the frontend is served from the same origin.
# ALLOWED_ORIGINS=http://localhost:5175
