.git/
.github/
.claude/

# Never ship the book. The PDF is never deployed, and the extracted corpus is
# fetched at container start from its private repo (bin/fetch-corpus) — a local
# clone in data/ must not leak into the image.
*.pdf
data/
script/

# Secrets must never enter the image. Railway injects real environment
# variables at runtime. `**/` so a .env at any depth is caught, not just
# backend/ — the repo root is the easy one to miss.
**/.env
**/.env.*

backend/tmp/
backend/log/
backend/public/assets/
backend/public/index.html

frontend/node_modules/
frontend/dist/

**/.DS_Store
**/*.log
backend/.bundle/
backend/vendor/bundle/
